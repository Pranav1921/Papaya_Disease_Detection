**/.pub/

# Android build & local configs
**/android/.gradle/
**/android/.gradle_home/
**/android/local.properties
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/*.apk
**/*.aab

# iOS & macOS build artifacts
**/ios/Flutter/.last_build_id
**/ios/Pods/
**/ios/.symlinks/
**/*.xcworkspace/xcuserdata/
**/*.xcodeproj/xcuserdata/

# Logs
*.log
**/*.log
backend_stderr.log
backend_stdout.log

# IDE and OS files
.DS_Store
Thumbs.db
.idea/
**/.idea/
*.iml
**/*.iml
.vscode/

