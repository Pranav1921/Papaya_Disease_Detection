# Virtual environments
venv/
.venv/
*/venv/
*/.venv/
env/
ENV/
*.env

# Python cache & bytecode
__pycache__/
*/__pycache__/
**/*.py[cod]
**/*$py.class
*.so
.pytest_cache/

# Flutter & Dart build artifacts
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
